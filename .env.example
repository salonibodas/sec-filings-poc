# =============================================================
# sec-filings-poc  —  FULLY LOCAL config (no external API keys)
# Copy this file to .env and adjust if needed.
# =============================================================

# --- ingest.py: SEC EDGAR fair-access requires a real contact email ---
EDGAR_COMPANY_NAME=SEC Filings POC
EDGAR_EMAIL=you@example.com

# --- ingest.py: optional overrides ---
# EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
# CHUNK_SIZE=1024
# CHUNK_OVERLAP=200
# MAX_FILINGS_PER_FORM=5     # cap downloads while testing; 0/unset = no limit

# --- kg.py + optimize.py: LOCAL Ollama, no API key needed ---
# Install Ollama (ollama.com), then: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# MAX_CHUNKS=50                # cap chunks sent to the model per kg.py run

# --- kg.py + optimize.py: LOCAL Neo4j via Docker ---
# docker run -d --name neo4j-sec -p 7474:7474 -p 7687:7687 \
#   -e NEO4J_AUTH=neo4j/localdev123 neo4j:5
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=localdev123
NEO4J_DATABASE=neo4j

# --- optimize.py: optional overrides ---
# BASELINE_TOP_K=5
# OPTIMIZED_TOP_K=3
# LLMLINGUA_RATE=0.5                  # fraction of context tokens kept after compression
# COST_PER_1K_INPUT_TOKENS=0.0        # local = $0; only set for hypothetical cloud comparison
# COST_PER_1K_OUTPUT_TOKENS=0.0
